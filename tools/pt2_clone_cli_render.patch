diff --git a/src/pt2_main.c b/src/pt2_main.c
index aa251a2..fc6f944 100644
--- a/src/pt2_main.c
+++ b/src/pt2_main.c
@@ -315,12 +315,17 @@ int main(int argc, char *argv[])
 	statusAllRight();
 
 	// load a .MOD from the command arguments if passed (also ignore OS X < 10.9 -psn argument on double-click launch)
+	// `--render` is a headless CLI mode: skip the modPlay() call so
+	// the speakers don't pipe out the song while mod2WavRender runs
+	// in parallel. modplayer's harness invokes pt2-clone-cli many
+	// times per test, and audio leaking out across those is loud.
+	const bool render_mode = (argc >= 4 && strcmp(argv[2], "--render") == 0);
 	if ((argc >= 2 && argv[1][0] != '\0') && (argc != 2 || strncmp(argv[1], "-psn_", 5)))
 	{
 		loadModFromArg(argv[1]);
 
-		// play song
-		if (song->loaded)
+		// play song (interactive only — skip when rendering headlessly)
+		if (song->loaded && !render_mode)
 		{
 			editor.playMode = PLAY_MODE_NORMAL;
 			modPlay(DONT_SET_PATTERN, 0, DONT_SET_ROW);
@@ -338,9 +343,14 @@ int main(int argc, char *argv[])
 	fillToVuMetersBgBuffer();
 	updateCursorPos();
 
-	SDL_ShowWindow(video.window);
+	// Headless render mode: keep the SDL window hidden. The GUI
+	// initialization above creates the window object, but never
+	// showing it keeps the harness clean — no flashing windows
+	// when the runner loops over many MOD fixtures.
+	if (!render_mode)
+		SDL_ShowWindow(video.window);
 
-	if (config.startInFullscreen)
+	if (config.startInFullscreen && !render_mode)
 		toggleFullscreen();
 
 	changePathToDesktop(); // change path to desktop now
@@ -348,6 +358,27 @@ int main(int argc, char *argv[])
 
 	SDL_EventState(SDL_DROPFILE, SDL_ENABLE);
 
+	// CLI mode: --render <output.wav> renders the loaded MOD to a WAV
+	// file and exits, no GUI interaction needed. Used by modplayer's
+	// SC2-corpus diff harness — pt2-clone is the reference for cases
+	// where libopenmpt diverges from authentic ProTracker playback.
+	if (argc >= 4 && strcmp(argv[2], "--render") == 0)
+	{
+		extern bool mod2WavRender(char *filename);
+		if (!song->loaded)
+		{
+			fprintf(stderr, "[pt2-cli] module didn't load: %s\n", argv[1]);
+			return 1;
+		}
+		mod2WavRender(argv[3]);
+		// mod2WavRender returns immediately after spawning the
+		// SDL render thread; wait for it to actually finish.
+		while (editor.mod2WavOngoing)
+			SDL_Delay(10);
+		fprintf(stderr, "[pt2-cli] rendered %s\n", argv[3]);
+		return 0;
+	}
+
 	editor.mainLoopOngoing = true;
 	hpc_ResetCounters(&video.vblankHpc); // this must be the last thing we do before entering the main loop
 
